    "type": "git",
    "url": "git+https://github.com/gstrosnider/homebridge-eufy-clean.git"
  },
  "bugs": {
    "url": "https://github.com/gstrosnider/homebridge-eufy-clean/issues"
  },
  "maintainers": [
    {
      "name": "gstrosnider",
      "url": "https://github.com/gstrosnider"
    }
  ],
  "contributors": [
    {
      "name": "gstrosnider",
      "url": "https://github.com/gstrosnider"
    }
  ]
}
